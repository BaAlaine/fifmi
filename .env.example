# Public site URL, used for canonical links, sitemaps and structured data.
NEXT_PUBLIC_SITE_URL=https://fifmi.org
# "true" shows labelled [CMS: ...] placeholders for content that is not yet verified.
# Keep "false" in production: unverified content is then hidden instead of invented.
NEXT_PUBLIC_SHOW_CMS_PLACEHOLDERS=true
# Analytics (cookieless). Leave empty to load no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
